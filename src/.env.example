# ------------------ 应用信息 ------------------
APP_NAME="FastAPI Template"
APP_DESCRIPTION="基于 FastAPI + SQLAlchemy + Pydantic v2 的异步后端模板"
APP_VERSION="0.1.0"
CONTACT_NAME="Your Name"
CONTACT_EMAIL="you@example.com"
LICENSE_NAME="MIT"

# ------------------ 日志 ------------------
LOG_LEVEL=INFO
DB_ECHO=false

# ------------------ 安全 ------------------
# 生成方式：openssl rand -hex 32
SECRET_KEY="change-me-please-generate-a-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------ PostgreSQL ------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fastapi_template

# ------------------ 管理员 ------------------
ADMIN_NAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ------------------ Redis（缓存 / 队列 / 限流） ------------------
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6379
REDIS_RATE_LIMIT_HOST=localhost
REDIS_RATE_LIMIT_PORT=6379

# ------------------ 限流默认值 ------------------
DEFAULT_RATE_LIMIT_LIMIT=10
DEFAULT_RATE_LIMIT_PERIOD=3600

# ------------------ 环境 ------------------
# local / staging / production
ENVIRONMENT=local

# -------------- embedding 模型配置 ----------------
# 目前使用的是阿里百炼平台的免费模型额度
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank

# -------------- DeepSeek 大模型配置 ----------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------ RAG 评估（RAGAS） ------------------
RAGAS_LLM_MODEL=deepseek-chat
RAGAS_METRICS=faithfulness,answer_relevancy,context_precision,context_recall

# ------------------ 可观测性（LangSmith） ------------------
# 启用后所有 LangGraph 调用自动上报分层追踪；需同时配置 API Key 才会真正开启
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=weather-agent

# ------------------ 可观测性（Metric / Log 层） ------------------
# 进程内指标统计窗口（保留最近多少轮轨迹）与 Token 成本估算单价（元/千 Token）
OBSERVABILITY_TRACE_WINDOW=200
OBSERVABILITY_COST_PER_1K_INPUT=0.002
OBSERVABILITY_COST_PER_1K_OUTPUT=0.008
OBSERVABILITY_STRUCTURED_LOG=true

# ------------------ 多 Agent 评估 ------------------
# LLM-as-Judge 判官（默认复用 DeepSeek）；阈值用于评估结果的 pass 判定
AGENT_JUDGE_MODEL=deepseek-chat
AGENT_JUDGE_ENABLED=true
AGENT_TARGET_COMPLETION_RATE=0.9
AGENT_TARGET_TOOL_ACCURACY=0.95
AGENT_TARGET_CONFLICT_RATE=0.05
AGENT_TARGET_AVG_LATENCY=5.0

# ------------------ 文件上传 ------------------
# 上传文件保存目录；默认位于项目根目录 storage/uploads，如需修改请取消注释并填写绝对路径
# UPLOAD_DIR=D:/project/pgsql_embedding_demo/storage/uploads
MAX_UPLOAD_SIZE_MB=100

# ------------------ 本地文档 ------------------
# RAG 离线阶段的文档根目录；/documents 接口只允许读取该目录下的文件
DOCUMENT_DIR=G:/Rag知识库
# 文本切分参数：每个 chunk 的最大字符数与相邻 chunk 的重叠字符数
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ------------------ Milvus 向量数据库 ------------------
# 是否启用 Milvus 连接，默认 false；未部署 Milvus 时保持 false 可避免连接报错
ENABLE_MILVUS=false
# 连接成功后是否自动创建 RAG 集合与索引，默认 false；开启后启动时自动初始化
AUTO_CREATE_RAG_COLLECTIONS=false
# Milvus standalone 的 gRPC 地址与端口（对应 docker-compose 的 19530 端口）
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 也可以直接指定完整 URI，优先于 HOST/PORT
# MILVUS_URI=http://localhost:19530
# 开启鉴权时填写（本模板默认不开启鉴权）
# MILVUS_TOKEN=
# MILVUS_USER=
# MILVUS_PASSWORD=
MILVUS_DB_NAME=default

# -------------- 和风天气（QWeather）JWT 认证配置 ----------------
# 私钥可在此填写 PEM 全文（用 \n 表示换行），代码会自动还原换行
QWEATHER_JWT_ALGORITHM=EdDSA
QWEATHER_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIJr+oYy9w7iO5NOkyXGn5JJZFxqFIwm21FESc7pHRlLN
-----END PRIVATE KEY-----"
QWEATHER_JWT_KEY_ID=CCGX435PA7
QWEATHER_JWT_SUBJECT=3G2D5BRYMW
# iss 仅在 API Host 订阅场景需要，标准 API 留空即可
QWEATHER_JWT_ISSUER=Q02BB2187F
# API Host 订阅域名
QWEATHER_API_HOST=nx63yyvk9m.re.qweatherapi.com
# 令牌有效期（秒）：86400 = 24 小时；和风天气要求 exp - iat 不超过 24 小时
QWEATHER_JWT_TTL_SECONDS=86400
QWEATHER_JWT_LEEWAY_SECONDS=30

# ------------------ 电商导购智能体 ------------------
# 商品检索源：builtin（内置目录，默认）/ pgvector / milvus / hybrid（RAG + 目录兜底）
ECOMMERCE_PRODUCT_SOURCE=builtin
ECOMMERCE_PRODUCT_TOP_K=5
ECOMMERCE_PRODUCT_MIN_SIMILARITY=0.3

# 短期记忆（Checkpointer）：memory（进程内，默认）/ postgres（需安装 langgraph-checkpoint-postgres）
ECOMMERCE_CHECKPOINT_BACKEND=memory
# 短期记忆窗口策略：truncate（默认）/ token / summary / hybrid
ECOMMERCE_WINDOW_STRATEGY=truncate
ECOMMERCE_WINDOW_MAX_MESSAGES=20
ECOMMERCE_WINDOW_MAX_TOKENS=4000
ECOMMERCE_WINDOW_SUMMARY_KEEP=10
ECOMMERCE_WINDOW_SUMMARY_HARD_LIMIT=50
ECOMMERCE_WINDOW_HYBRID_KEEP=12
ECOMMERCE_WINDOW_HYBRID_MAX_TOKENS=3000
ECOMMERCE_WINDOW_HYBRID_HARD_LIMIT=60
ECOMMERCE_WINDOW_TOOL_MAX_CHARS=800

# 长期记忆（MemoryStore）：inmemory（进程内零依赖，默认）/ postgres（pgvector，需启用扩展）
ECOMMERCE_MEMORY_BACKEND=inmemory
ECOMMERCE_MEMORY_TOP_K=3
ECOMMERCE_MEMORY_DECAY_DAYS=30
ECOMMERCE_MEMORY_MIN_RELEVANCE=0.2
ECOMMERCE_MEMORY_MAX_PER_USER=100
ECOMMERCE_PROFILE_MAX_PREFS=6
ECOMMERCE_PROFILE_SUMMARY_MAX_CHARS=400

# ------------------ 实时语音对话（Qwen3-ASR + CosyVoice） ------------------
# 识别模型与语言
VOICE_ASR_MODEL=qwen3-asr-flash-realtime
VOICE_ASR_LANGUAGE=zh
# 分句模式：manual（前端检测静音后发送 end_turn，默认）/ server_vad（服务端断句）
VOICE_ASR_TURN_MODE=manual
# 静音分句时长（毫秒）：manual 模式下前端用它对标「说完一句」
VOICE_ASR_SILENCE_DURATION_MS=800
# 识别会话建连/关闭线程池大小与超时（秒）
VOICE_ASR_MAX_WORKERS=4
VOICE_ASR_TIMEOUT_S=10
# 语音回复是否跳过「长期记忆提取」这次额外 LLM 调用：true 首答更快（默认）
VOICE_SKIP_MEMORY_WRITE=true
# 语音合成后端：dashscope（默认，模型以 cosyvoice 开头时走 CosyVoice 2）
VOICE_TTS_BACKEND=dashscope
VOICE_TTS_MODEL=cosyvoice-v2
VOICE_TTS_VOICE=longxiaochun_v2
# 语音合成线程池大小与单句合成超时（秒）
VOICE_TTS_MAX_WORKERS=4
VOICE_TTS_TIMEOUT_S=15

# ------------------ 钉协助手智能体（dws CLI） ------------------
# dws 可执行文件，默认从 PATH 查找，也可填绝对路径
DINGTALK_DWS_BIN=dws
# 写操作总开关：发消息 / DING / 创建日程待办等；默认 false，确认安全后再打开。
# 打开它只是「允许写」，真正执行还需要用户确认（编排器确认闭环 / 快捷办理表单的 confirm=true）；
# 纯对话入口（POST /api/v1/dingtalk/chat）始终只做预演（dws --dry-run）。
DINGTALK_ENABLE_WRITE=false
DINGTALK_TIMEOUT_SECONDS=30
DINGTALK_OUTPUT_MAX_CHARS=4000
# 群自定义机器人 Webhook token（机器人消息用；敏感，勿提交）
# DINGTALK_ROBOT_WEBHOOK_TOKEN=

# ------------------ 智能问数（Text-to-SQL） ------------------
# 采用「黑名单 + 全局只读」：默认开放所有表，仅排除下列表与敏感列
# 留空表示开放所有表；敏感列不会进入大模型可见的表结构，被执行守卫二次拦截
BI_TABLE_BLOCKLIST=
BI_SENSITIVE_COLUMNS=password_hash,embedding
BI_MAX_ROWS=100
BI_QUERY_TIMEOUT_SECONDS=10
BI_SCHEMA_CACHE_TTL_SECONDS=300
BI_SQL_MAX_RETRIES=2
BI_TEMPERATURE=0
BI_CHART_ENABLED=true
BI_HISTORY_MESSAGES=6
# 问数可换用其他 OpenAI 兼容模型（留空则复用上面的 DEEPSEEK_* 配置）
# BI_LLM_MODEL=deepseek-chat
# BI_LLM_BASE_URL=https://api.deepseek.com
# BI_LLM_API_KEY=

# ------------------ 多智能体编排器 ------------------
# 子智能体调用方式：inprocess（进程内，默认）/ a2a（远程 A2A 协议）
ORCHESTRATOR_SUBAGENT_TRANSPORT=inprocess

# ------------------ A2A 协议层（ORCHESTRATOR_SUBAGENT_TRANSPORT=a2a 时使用） ------------------
# 说明：当前仓库只接入 A2A 客户端（网关调用远程子智能体服务），
# 尚未在应用内挂载 A2A 服务端（core/agents/a2a/server.py 的 build_a2a_mounts 未被调用），
# 因此子智能体需由独立进程按同一份 Agent Card 暴露。
# Agent Card 对外暴露的基础 URL，需与真实服务地址一致
A2A_PUBLIC_BASE_URL=http://localhost:8000
# 任务持久化后端：memory（进程内，推荐本地开发）/ sqlite / postgres
A2A_TASK_STORE=memory
# A2A_TASK_STORE=postgres 时的异步连接串；留空则按 POSTGRES_* 自动拼接
# A2A_POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
A2A_CLIENT_TIMEOUT_SECONDS=30
A2A_CLIENT_MAX_CONNECTIONS=100
A2A_CLIENT_MAX_KEEPALIVE_CONNECTIONS=20
A2A_CLIENT_MAX_RETRIES=2
A2A_CLIENT_RETRY_BACKOFF_SECONDS=0.5
